{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "base",
          "color": "#F7F8FA",
          "name": "Blanco roto"
        },
        {
          "slug": "surface",
          "color": "#ECEFF4",
          "name": "Superficie"
        },
        {
          "slug": "contrast",
          "color": "#0A0A0C",
          "name": "Negro"
        },
        {
          "slug": "contrast-soft",
          "color": "#5A616E",
          "name": "Gris texto"
        },
        {
          "slug": "accent",
          "color": "#153E6E",
          "name": "Azul marca"
        },
        {
          "slug": "accent-deep",
          "color": "#0B2545",
          "name": "Azul profundo"
        },
        {
          "slug": "steel",
          "color": "#8A97AB",
          "name": "Acero"
        },
        {
          "slug": "line",
          "color": "#DCE1E9",
          "name": "Línea"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Cormorant Garamond\", \"Iowan Old Style\", Palatino, Georgia, serif"
        },
        {
          "slug": "body",
          "name": "Texto",
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Pequeño",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Normal",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Grande",
          "size": "1.375rem",
          "fluid": { "min": "1.25rem", "max": "1.5rem" }
        },
        {
          "slug": "x-large",
          "name": "Título",
          "size": "2.5rem",
          "fluid": { "min": "1.875rem", "max": "3rem" }
        },
        {
          "slug": "xx-large",
          "name": "Portada",
          "size": "4rem",
          "fluid": { "min": "2.75rem", "max": "5rem" }
        }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "20", "name": "1 · XS", "size": "0.75rem" },
        { "slug": "30", "name": "2 · S", "size": "1.25rem" },
        { "slug": "40", "name": "3 · M", "size": "2rem" },
        { "slug": "50", "name": "4 · L", "size": "3.5rem" },
        { "slug": "60", "name": "5 · XL", "size": "5.5rem" },
        { "slug": "70", "name": "6 · XXL", "size": "8rem" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Suave",
          "shadow": "0 1px 2px rgba(22, 17, 13, 0.04), 0 8px 24px rgba(22, 17, 13, 0.06)"
        },
        {
          "slug": "lifted",
          "name": "Elevada",
          "shadow": "0 2px 4px rgba(22, 17, 13, 0.05), 0 16px 40px rgba(22, 17, 13, 0.10)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)",
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "500",
          "lineHeight": "1.12",
          "letterSpacing": "-0.015em"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--contrast)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--accent)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "2px" },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "1rem",
            "left": "2rem",
            "right": "2rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "0.8125rem",
          "fontWeight": "600",
          "letterSpacing": "0.09em",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-deep)",
            "text": "var(--wp--preset--color--base)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "1.5rem",
          "fontWeight": "500",
          "letterSpacing": "0.02em",
          "textTransform": "uppercase"
        }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--line)" }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Cabecera", "area": "header" },
    { "name": "footer", "title": "Pie", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "page-ancha",
      "title": "Página ancha (sin barra)",
      "postTypes": ["page"]
    }
  ]
}
