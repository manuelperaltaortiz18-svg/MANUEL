//@version=6
// =============================================================================
//  Rift Volume Profile Engine — VERSIÓN ESTRATEGIA (ejecuta de verdad)
//
//  Conversión del indicador original a `strategy()`. La lógica de señales es la
//  MISMA, línea por línea: perfil de volumen anclado, POC / Value Area / POV,
//  divergencia de CVD, delta de barra, y los tres modelos (Sweep & Reclaim,
//  POC Bounce, POV Void). Lo que se añade es la ejecución.
//
//  Qué cambia respecto al indicador:
//    1. Órdenes reales -> TradingView calcula profit factor, drawdown, etc.
//    2. Entrada a MERCADO en la apertura de la vela siguiente. La señal es un
//       cierre; fingir que se entra a ese mismo cierre falsea el backtest.
//    3. Bracket CONGELADO al entrar. El SL del original sale de `dVal`/`dPoc`,
//       que se recalculan en cada vela y valen `na` al cambiar de perfil: si el
//       exit se recalculase desde ahí, un solo `na` deja la posición sin stop
//       ni objetivo, y solo la cierra el final de la sesión.
//    4. Tamaño de posición derivado del stop (riesgo fijo por operación).
//    5. Cortacircuitos: operaciones/día, pérdidas seguidas, pérdida diaria y
//       drawdown máximo — las reglas que tumban cuentas de prop firm.
//    6. `i_tpMode = "Next Node Target"` implementado. En el original era un
//       input muerto: solo existía el múltiplo de R.
//
//  El ratio por defecto sigue siendo 1:2 (i_rr = 2.0).
//
//  IMPORTANTE: configura comisión y deslizamiento en Propiedades antes de
//  mirar ningún resultado.
// =============================================================================

strategy("Rift Volume Profile Engine [Strategy]", shorttitle = "Rift ST",
 overlay = true, max_lines_count = 500, max_labels_count = 500,
 max_boxes_count = 500, max_polylines_count = 100, precision = 6,
 explicit_plot_zorder = true, calc_bars_count = 5000,
 initial_capital = 100000, default_qty_type = strategy.fixed,
 default_qty_value = 1, pyramiding = 0, calc_on_every_tick = false,
 close_entries_rule = "ANY")

// =============================================================================
// INPUT CONFIGURATION
// =============================================================================

// Webhook & Automation Settings
g_tw = "Webhook Automation Engine"
tw_enabled = input.bool(true, "Enable Webhook Signals", group = g_tw)
tw_symbol = input.string("", "Symbol Override (Blank = Chart Symbol)", group = g_tw)
tw_vol_type = input.string("RISK", "Volume Sizing Mode", ["RISK", "VOL"], group = g_tw, inline = "twv")
tw_vol_val = input.float(1.0, "Risk % or Fixed Volume", minval = 0.0, step = 0.1, group = g_tw, inline = "twv")
tw_opp_close = input.bool(true, "Close Opposite Trades", group = g_tw, inline = "twc")
tw_magic = input.string("", "Magic Order ID", group = g_tw, inline = "twm")
tw_comment = input.string("Rift_Signal", "Order Comment", group = g_tw, inline = "twm")

// Volume Profile Engine Configuration
g_pf = "Volume Profile Engine"
i_anchor = input.string("Period", "Profile Anchor Type", ["Period", "Swing"], group = g_pf, inline = "an1")
i_swingLen = input.int(10, "Swing Pivot Lookback", minval = 2, maxval = 50, group = g_pf, inline = "an1")
i_period = input.timeframe("D", "Anchor Period", group = g_pf)
i_ltf = input.timeframe("1", "Intrabar Data Feed", options = ["1S", "1", "5", "15"], group = g_pf)
i_ticks = input.float(0, "Ticks Per Row (0 = Auto)", minval = 0, group = g_pf, inline = "rw1")
i_atrRows = input.float(8.0, "Auto Granularity (ATR / N)", minval = 2, maxval = 50, step = 0.5, group = g_pf, inline = "rw1")
i_vaPct = input.float(70.0, "Value Area Target %", minval = 50, maxval = 95, step = 1, group = g_pf, inline = "va1")
i_hist = input.int(5, "Historical Profiles Retained", minval = 0, maxval = 15, group = g_pf, inline = "va1")

// Signal Model Filters
g_sg = "Trading Signal Models"
i_sigMode = input.string("All", "Signal Rules Strategy", ["All", "Sweep & Reclaim", "POC Bounce", "POV Void"], group = g_sg)
i_div = input.bool(true, "Require CVD Divergence", group = g_sg, inline = "dv1")
i_divLen = input.int(30, "Divergence Lookback", minval = 5, group = g_sg, inline = "dv1")
i_deltaConf = input.bool(true, "Require Bar Delta Bias", group = g_sg)
i_dirMode = input.string("Both", "Trade Direction Target", ["Both", "Longs Only", "Shorts Only"], group = g_sg, inline = "dr1")
i_sigCool = input.int(8, "Signal Cooldown Period", minval = 0, maxval = 300, group = g_sg)

// Safety & Trend Filters
g_fl = "Filter Safety Rules"
i_f_mom = input.bool(false, "ATR Momentum Filter", group = g_fl, inline = "fl1")
i_momMult = input.float(2.0, "Max Range Scale (ATR x)", minval = 0.5, maxval = 10, step = 0.25, group = g_fl, inline = "fl1")
i_f_wick = input.bool(false, "Rejection Wick Ratio", group = g_fl, inline = "fl2")
i_wickPct = input.float(30.0, "Min Wick % Range", minval = 5, maxval = 90, group = g_fl, inline = "fl2")
i_f_ema = input.bool(false, "Trend Alignment EMA Filter", group = g_fl, inline = "fl3")
i_emaLen = input.int(200, "EMA Length", minval = 5, group = g_fl, inline = "fl3")
i_f_sess = input.bool(false, "Trading Session Window Filter", group = g_fl, inline = "fl4")
i_sess = input.session("0800-1700", "Trading Window", group = g_fl, inline = "fl4")

// Risk Management Settings
g_rk = "Risk & Position Rules"
i_slMode = input.string("ATR Beyond Sweep", "Stop-Loss Engine", ["ATR Beyond Sweep", "Beyond Origin Node"], group = g_rk, inline = "rk0")
i_tpMode = input.string("R Multiple", "Take-Profit Engine", ["R Multiple", "Next Node Target"], group = g_rk, inline = "rk0")
i_slAtrM = input.float(1.5, "SL Distance: ATR Multiplier", minval = 0.1, step = 0.1, group = g_rk, inline = "rk1")
i_slAtrL = input.int(14, "ATR Lookback Length", minval = 2, group = g_rk, inline = "rk1")
i_rr = input.float(2.0, "Risk/Reward Target Ratio", minval = 0.2, step = 0.1, group = g_rk, inline = "rk2")
i_nodeBuf = input.float(0.25, "Node Protection Buffer (ATR x)", minval = 0.0, maxval = 3, step = 0.05, group = g_rk, inline = "rk2")
i_nodeShare = input.float(0.5, "Next Node: Min Volume Share", minval = 0.1, maxval = 1.0, step = 0.05, group = g_rk,
 tooltip = "Solo para 'Next Node Target': un nodo cuenta como objetivo si su volumen alcanza esta fracción del nodo mayor.")
i_nodeMinRR = input.float(1.0, "Next Node: Min R Accepted", minval = 0.1, step = 0.1, group = g_rk,
 tooltip = "Si el nodo más cercano queda a menos de este múltiplo de R, se usa el múltiplo fijo en su lugar.")

// Execution & Account Rules (nuevo: el indicador no ejecutaba)
g_ex = "Execution & Account Rules"
i_qtyStep = input.float(1.0, "Volume Step", minval = 0.001, step = 0.001, group = g_ex, inline = "ex1")
i_qtyMin = input.float(1.0, "Minimum Volume", minval = 0.001, step = 0.001, group = g_ex, inline = "ex1")
i_maxPerDay = input.int(3, "Max Trades Per Session", minval = 1, group = g_ex, inline = "ex2")
i_maxLosses = input.int(3, "Stop After N Losses In A Row", minval = 1, group = g_ex, inline = "ex2")
i_dailyLoss = input.float(2.0, "Daily Loss Limit %", minval = 0.0, step = 0.1, group = g_ex, inline = "ex3")
i_maxDd = input.float(0.0, "Max Total Drawdown % (0 = off)", minval = 0.0, step = 0.5, group = g_ex, inline = "ex3")
i_flatEod = input.bool(false, "Flatten At Session End", group = g_ex, inline = "ex4",
 tooltip = "Cierra toda posición cuando termina la ventana de sesión configurada en los filtros.")

// Visualization Settings
g_vx = "Chart Render & Visuals"
i_v_profile = input.bool(true, "Render Margin Profile", group = g_vx, inline = "vx1")
i_bins = input.int(30, "Profile Rows Resolution", minval = 10, maxval = 60, group = g_vx, inline = "vx1")
i_profOff = input.int(8, "Margin Shift Offset", minval = 2, maxval = 100, group = g_vx, inline = "vx2")
i_profW = input.int(40, "Profile Scale Width", minval = 5, maxval = 200, group = g_vx, inline = "vx2")
i_profText = input.bool(true, "Show Node Volume Text", group = g_vx, inline = "vx3")
i_v_levels = input.bool(true, "Plot POC / VA / POV Levels", group = g_vx, inline = "vx3")
i_v_labels = input.bool(true, "Plot Chart Signals", group = g_vx, inline = "vx8")
i_v_trade = input.bool(true, "Draw Live Trade Levels", group = g_vx, inline = "vx8b")
i_colBull = input.color(#00e1ff, "Bullish Color", group = g_vx, inline = "vx9")
i_colBear = input.color(#ff3d71, "Bearish Color", group = g_vx, inline = "vx9")
i_colPoc = input.color(#ffd740, "POC Accent", group = g_vx, inline = "vx0")
i_colVa = input.color(#7c4dff, "Value Area Accent", group = g_vx, inline = "vx0")
i_colVoid = input.color(#ff9100, "POV Accent", group = g_vx, inline = "vx9")

// Dashboard Settings
g_db = "Information Dashboard"
i_dbShow = input.bool(true, "Display Dashboard", group = g_db, inline = "db1")
i_dbLoc = input.string("Bottom Right", "Location On Chart", ["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left"], group = g_db, inline = "db1")
i_dbSize = input.string("Small", "Dashboard Size", ["Tiny", "Small", "Normal", "Large"], group = g_db, inline = "db2")

// =============================================================================
// ENGINE DATA TYPES & MEMORY MANAGEMENT
// =============================================================================

type Profile
    float base = na
    float rowSize = na
    int startBar = na
    float[] buy
    float[] sell
    float[] tot

f_newProfile(float rs, int bi, float refPrice) =>
    b = math.floor(refPrice / rs) * rs
    Profile.new(b, rs, bi, array.new<float>(), array.new<float>(), array.new<float>())

f_rowIdx(Profile p, float px) =>
    int(math.floor((px - p.base) / p.rowSize))

f_grow(Profile p, int i0, int i1) =>
    int a = i0
    int b = i1
    while b > p.tot.size() - 1 and p.tot.size() < 400
        p.buy.push(0.0)
        p.sell.push(0.0)
        p.tot.push(0.0)
    while a < 0 and p.tot.size() < 400
        p.buy.unshift(0.0)
        p.sell.unshift(0.0)
        p.tot.unshift(0.0)
        p.base -= p.rowSize
        a += 1
        b += 1
    [a, b]

f_pocVa(Profile p, float vaPct) =>
    sz = p.tot.size()
    float poc = na
    float vah = na
    float val = na
    float pov = na
    int pocIdx = 0
    int povIdx = -1
    int bt = 0
    int tp = 0
    if sz > 0 and p.tot.sum() > 0
        float mx = p.tot.max()
        pocIdx := p.tot.indexof(mx)
        poc := p.base + pocIdx * p.rowSize + p.rowSize / 2
        target = p.tot.sum() * vaPct / 100.0
        acc = mx
        bt := pocIdx
        tp := pocIdx
        while acc < target and (bt > 0 or tp < sz - 1)
            up = tp < sz - 1 ? p.tot.get(tp + 1) : -1.0
            dn = bt > 0 ? p.tot.get(bt - 1) : -1.0
            if up >= dn
                tp += 1
                acc += math.max(up, 0.0)
            else
                bt -= 1
                acc += math.max(dn, 0.0)
        vah := p.base + (tp + 1) * p.rowSize
        val := p.base + bt * p.rowSize
        float minV = na
        for x = bt to tp
            vx = p.tot.get(x)
            if x != pocIdx and (na(minV) or vx < minV)
                minV := vx
                povIdx := x
        if povIdx >= 0
            pov := p.base + povIdx * p.rowSize + p.rowSize / 2
    [poc, vah, val, pocIdx, bt, tp, pov, povIdx]

// Primer nodo relevante por encima / por debajo de un precio. Implementa el
// modo "Next Node Target", que en el indicador original era un input muerto.
f_nodeAbove(Profile p, float px, float share) =>
    float best = na
    sz = p.tot.size()
    if sz > 0 and p.tot.sum() > 0
        mx = p.tot.max()
        for x = 0 to sz - 1
            lvl = p.base + x * p.rowSize + p.rowSize / 2
            if na(best) and lvl > px and p.tot.get(x) >= mx * share
                best := lvl
    best

f_nodeBelow(Profile p, float px, float share) =>
    float best = na
    sz = p.tot.size()
    if sz > 0 and p.tot.sum() > 0
        mx = p.tot.max()
        for x = sz - 1 to 0
            lvl = p.base + x * p.rowSize + p.rowSize / 2
            if na(best) and lvl < px and p.tot.get(x) >= mx * share
                best := lvl
    best

// Core Data Analytics
atr14 = ta.atr(14)
[ltfVol, ltfDir, ltfHi, ltfLo] = request.security_lower_tf(syminfo.tickerid, i_ltf, [volume, math.sign(close - close[1]), high, low])

pivH = ta.pivothigh(high, i_swingLen, i_swingLen)
pivL = ta.pivotlow(low, i_swingLen, i_swingLen)
var int swingDir = 0
swingReset = false
if i_anchor == "Swing"
    if not na(pivL) and swingDir != 1
        swingDir := 1
        swingReset := true
    if not na(pivH) and swingDir != -1
        swingDir := -1
        swingReset := true
newPeriod = i_anchor == "Swing" ? swingReset : timeframe.change(i_period)

var Profile prof = na
if newPeriod or na(prof)
    rs = i_ticks > 0 ? i_ticks * syminfo.mintick : atr14 / i_atrRows
    rs := math.max(rs, syminfo.mintick)
    sb = i_anchor == "Swing" ? math.max(bar_index - i_swingLen, 0) : bar_index
    prof := f_newProfile(rs, sb, open)

var float cvd = 0.0
if newPeriod
    cvd := 0.0
barDelta = 0.0

if ltfVol.size() > 0
    for i = 0 to ltfVol.size() - 1
        v = nz(ltfVol.get(i))
        d = nz(ltfDir.get(i))
        hi = ltfHi.get(i)
        lo = ltfLo.get(i)
        barDelta += (v * d)
        if v > 0 and not na(hi) and not na(lo)
            r0 = f_rowIdx(prof, lo)
            r1 = f_rowIdx(prof, hi)
            [g0, g1] = f_grow(prof, r0, r1)
            g0 := math.max(g0, 0)
            g1 := math.min(g1, prof.tot.size() - 1)
            if g0 <= g1
                cnt = g1 - g0 + 1
                per = v / cnt
                for x = g0 to g1
                    prof.tot.set(x, prof.tot.get(x) + per)
                    if d > 0
                        prof.buy.set(x, prof.buy.get(x) + per)
                    if d < 0
                        prof.sell.set(x, prof.sell.get(x) + per)
                    if d == 0
                        prof.buy.set(x, prof.buy.get(x) + per / 2)
                        prof.sell.set(x, prof.sell.get(x) + per / 2)

cvd += barDelta
[dPoc, dVah, dVal, dPocIdx, dBt, dTp, dPov, dPovIdx] = f_pocVa(prof, i_vaPct)
profRows = prof.tot.size()
profMax = profRows > 0 ? prof.tot.max() : 0.0

f_volFmt(float v) =>
    av = math.abs(v)
    av >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : av >= 1e3 ? str.tostring(v / 1e3, "#.#") + "K" : str.tostring(v, "#")

// =============================================================================
// SIGNALS & TRADING LOGIC ENGINE  (idéntico al indicador original)
// =============================================================================

atrSL = ta.atr(i_slAtrL)
divLongOK = not i_div or (low < ta.lowest(low[1], i_divLen) and cvd > ta.lowest(cvd[1], i_divLen))
divShortOK = not i_div or (high > ta.highest(high[1], i_divLen) and cvd < ta.highest(cvd[1], i_divLen))
dLongOK = not i_deltaConf or barDelta > 0
dShortOK = not i_deltaConf or barDelta < 0

sweepL = not na(dVal) and low < dVal and close > dVal and close > open
sweepS = not na(dVah) and high > dVah and close < dVah and close < open
bounceL = not na(dPoc) and low <= dPoc and close > dPoc and close > open and low > dVal
bounceS = not na(dPoc) and high >= dPoc and close < dPoc and close < open and high < dVah
voidL = not na(dPov) and close > dPov and close[1] <= dPov and close > open
voidS = not na(dPov) and close < dPov and close[1] >= dPov and close < open

barRng = high - low
momOK = not i_f_mom or barRng <= atrSL * i_momMult
wickL = barRng > 0 ? (math.min(open, close) - low) / barRng * 100 : 0.0
wickS = barRng > 0 ? (high - math.max(open, close)) / barRng * 100 : 0.0
wickOKL = not i_f_wick or wickL >= i_wickPct
wickOKS = not i_f_wick or wickS >= i_wickPct
emaV = ta.ema(close, i_emaLen)
emaOKL = not i_f_ema or close > emaV
emaOKS = not i_f_ema or close < emaV
sessOK = not i_f_sess or not na(time(timeframe.period, i_sess))

modeSwp = i_sigMode == "All" or i_sigMode == "Sweep & Reclaim"
modeBnc = i_sigMode == "All" or i_sigMode == "POC Bounce"
modeVd = i_sigMode == "All" or i_sigMode == "POV Void"

rawL = (modeSwp and sweepL and wickOKL) or (modeBnc and bounceL and wickOKL) or (modeVd and voidL)
rawS = (modeSwp and sweepS and wickOKS) or (modeBnc and bounceS and wickOKS) or (modeVd and voidS)

longOK = i_dirMode != "Shorts Only"
shortOK = i_dirMode != "Longs Only"

float nodePxL = sweepL ? dVal : bounceL ? dPoc : voidL ? dPov : na
float nodePxS = sweepS ? dVah : bounceS ? dPoc : voidS ? dPov : na

var int lastLBar = na
var float lastLNode = na
var int lastSBar = na
var float lastSNode = na
dupL = not na(lastLBar) and bar_index - lastLBar < i_sigCool and not na(nodePxL) and not na(lastLNode) and math.abs(nodePxL - lastLNode) < atrSL
dupS = not na(lastSBar) and bar_index - lastSBar < i_sigCool and not na(nodePxS) and not na(lastSNode) and math.abs(nodePxS - lastSNode) < atrSL

// FINAL SIGNAL EVALUATIONS
longSignal = rawL and divLongOK and dLongOK and momOK and emaOKL and sessOK and longOK and not dupL and not newPeriod
shortSignal = rawS and divShortOK and dShortOK and momOK and emaOKS and sessOK and shortOK and not dupS and not newPeriod

slLong = math.round_to_mintick(i_slMode == "Beyond Origin Node" and not na(nodePxL) ? math.min(low, nodePxL) - atrSL * i_nodeBuf : low - atrSL * i_slAtrM)
slShort = math.round_to_mintick(i_slMode == "Beyond Origin Node" and not na(nodePxS) ? math.max(high, nodePxS) + atrSL * i_nodeBuf : high + atrSL * i_slAtrM)

// Objetivo: múltiplo de R, o el siguiente nodo de volumen si se pide y queda
// lo bastante lejos como para pagar el riesgo.
tpLongR = close + (close - slLong) * i_rr
tpShortR = close - (slShort - close) * i_rr
nodeUp = i_tpMode == "Next Node Target" ? f_nodeAbove(prof, close, i_nodeShare) : na
nodeDn = i_tpMode == "Next Node Target" ? f_nodeBelow(prof, close, i_nodeShare) : na
riskLong = close - slLong
riskShort = slShort - close
useNodeL = not na(nodeUp) and riskLong > 0 and (nodeUp - close) >= riskLong * i_nodeMinRR
useNodeS = not na(nodeDn) and riskShort > 0 and (close - nodeDn) >= riskShort * i_nodeMinRR
tpLong = math.round_to_mintick(useNodeL ? nodeUp : tpLongR)
tpShort = math.round_to_mintick(useNodeS ? nodeDn : tpShortR)

if longSignal
    lastLBar := bar_index
    lastLNode := nodePxL
if shortSignal
    lastSBar := bar_index
    lastSNode := nodePxS

// =============================================================================
// EXECUTION — CORTACIRCUITOS DE CUENTA
// =============================================================================

isNewDay = timeframe.change("D")
var int tradesToday = 0
var int consecLosses = 0
var float dayStartEq = na
var int processedTrades = 0
var float peakEquity = na
var bool accountBlown = false

if isNewDay
    tradesToday := 0
    consecLosses := 0
    dayStartEq := strategy.equity

if strategy.closedtrades > processedTrades
    for i = processedTrades to strategy.closedtrades - 1
        pnl = strategy.closedtrades.profit(i)
        if pnl < 0
            consecLosses := consecLosses + 1
        else if pnl > 0
            consecLosses := 0
    processedTrades := strategy.closedtrades

if strategy.position_size != 0 and strategy.position_size[1] == 0
    tradesToday := tradesToday + 1

peakEquity := na(peakEquity) ? strategy.equity : math.max(peakEquity, strategy.equity)
if i_maxDd > 0 and not na(peakEquity)
    if strategy.equity <= peakEquity * (1.0 - i_maxDd / 100.0)
        accountBlown := true

dayPnl = na(dayStartEq) ? 0.0 : strategy.equity - dayStartEq
dailyLossHit = i_dailyLoss > 0 and not na(dayStartEq) and
                 dayPnl <= -dayStartEq * i_dailyLoss / 100.0

canTrade = not accountBlown and tradesToday < i_maxPerDay and
           consecLosses < i_maxLosses and not dailyLossHit

// =============================================================================
// EXECUTION — TAMAÑO DE POSICIÓN
// =============================================================================

// El tamaño lo decide el stop, nunca al revés. En modo VOL se respeta el
// volumen fijo que ya configuraba el webhook.
f_size(float riskPts) =>
    float raw = 0.0
    if tw_vol_type == "VOL"
        raw := tw_vol_val
    else
        budget = strategy.equity * tw_vol_val / 100.0
        raw := riskPts > 0 ? budget / (riskPts * syminfo.pointvalue) : 0.0
    stepped = i_qtyStep > 0 ? math.floor(raw / i_qtyStep) * i_qtyStep : raw
    stepped >= i_qtyMin ? stepped : 0.0

qtyLong = f_size(riskLong)
qtyShort = f_size(riskShort)

// =============================================================================
// EXECUTION — ÓRDENES CON BRACKET CONGELADO
//
//  Los niveles se fijan al enviar la entrada y viven en variables persistentes.
//  NUNCA se recalculan desde dVal / dPoc / dPov: esos valores cambian en cada
//  vela y valen `na` al abrirse un perfil nuevo. Si el exit dependiera de ellos,
//  bastaría un `na` para dejar la posición sin stop y sin objetivo.
// =============================================================================

var float armedStop = na
var float armedTarget = na
var float openEntryPx = na   // precio real de entrada, leído una sola vez
var bool targetFixed = false
var int nakedBars = 0

canEnter = canTrade and (tw_opp_close or strategy.position_size == 0)
takeLong = longSignal and canEnter and qtyLong > 0 and riskLong > 0
takeShort = shortSignal and canEnter and qtyShort > 0 and riskShort > 0

if takeLong
    armedStop := slLong
    armedTarget := tpLong
    targetFixed := false
    strategy.entry("RIFT_L", strategy.long, qty = qtyLong, comment = "Rift long")
    strategy.exit("RIFT_L_x", from_entry = "RIFT_L", stop = armedStop, limit = armedTarget,
         comment_loss = "SL", comment_profit = "TP")

if takeShort
    armedStop := slShort
    armedTarget := tpShort
    targetFixed := false
    strategy.entry("RIFT_S", strategy.short, qty = qtyShort, comment = "Rift short")
    strategy.exit("RIFT_S_x", from_entry = "RIFT_S", stop = armedStop, limit = armedTarget,
         comment_loss = "SL", comment_profit = "TP")

if strategy.position_size != 0
    if strategy.opentrades > 0
        openEntryPx := strategy.opentrades.entry_price(0)

    // Con el llenado ya conocido, el objetivo se recoloca UNA vez para que el
    // ratio sea exacto desde el precio real de entrada. El stop no se mueve.
    // En modo "Next Node Target" el objetivo es un nivel del perfil, así que se
    // respeta tal cual: moverlo destruiría el propio concepto.
    if not targetFixed and not na(openEntryPx) and not na(armedStop)
        fill = openEntryPx
        risk = math.abs(fill - armedStop)
        if risk > 0
            keepNode = i_tpMode == "Next Node Target" and
                 (strategy.position_size > 0 ? useNodeL : useNodeS)
            if not keepNode
                armedTarget := strategy.position_size > 0 ? fill + risk * i_rr
                     : fill - risk * i_rr
            targetFixed := true

    if not na(armedStop) and not na(armedTarget)
        if strategy.position_size > 0
            strategy.exit("RIFT_L_x", from_entry = "RIFT_L", stop = armedStop,
                 limit = armedTarget, comment_loss = "SL", comment_profit = "TP")
        else
            strategy.exit("RIFT_S_x", from_entry = "RIFT_S", stop = armedStop,
                 limit = armedTarget, comment_loss = "SL", comment_profit = "TP")
    else
        nakedBars := nakedBars + 1
else
    targetFixed := false
    armedStop := na
    armedTarget := na
    openEntryPx := na

// Cierre forzado: fin de ventana de sesión o cuenta reventada.
sessionEnded = i_flatEod and i_f_sess and na(time(timeframe.period, i_sess)) and
               not na(time(timeframe.period, i_sess)[1])
if (sessionEnded or accountBlown) and strategy.position_size != 0
    strategy.close_all(comment = accountBlown ? "max drawdown" : "session end")

// =============================================================================
// SIGNALS & VISUAL DRAWINGS ON CHART
// =============================================================================

plotshape(longSignal and i_v_labels, title = "BUY Signal Shape", style = shape.triangleup,
 location = location.belowbar, color = i_colBull, size = size.small)
plotshape(shortSignal and i_v_labels, title = "SELL Signal Shape", style = shape.triangledown,
 location = location.abovebar, color = i_colBear, size = size.small)

plot(i_v_levels and not na(dPoc) ? dPoc : na, "POC", color = i_colPoc,
 style = plot.style_linebr, linewidth = 2)
plot(i_v_levels and not na(dVah) ? dVah : na, "VAH", color = i_colVa,
 style = plot.style_linebr, linewidth = 1)
plot(i_v_levels and not na(dVal) ? dVal : na, "VAL", color = i_colVa,
 style = plot.style_linebr, linewidth = 1)
plot(i_v_levels and not na(dPov) ? dPov : na, "POV", color = i_colVoid,
 style = plot.style_linebr, linewidth = 1)

// Niveles de la operación viva. Si la distancia al objetivo no es el doble de
// la distancia al stop, el 1:2 no se está cumpliendo — se ve a simple vista.
inTrade = strategy.position_size != 0
plot(i_v_trade ? openEntryPx : na, "Entry", color = color.white,
 style = plot.style_linebr, linewidth = 1)
plot(i_v_trade and inTrade ? armedStop : na, "Stop", color = i_colBear,
 style = plot.style_linebr, linewidth = 2)
plot(i_v_trade and inTrade ? armedTarget : na, "Target", color = i_colBull,
 style = plot.style_linebr, linewidth = 2)

// =============================================================================
// WEBHOOK AUTOMATION ALERTS ENGINE
// =============================================================================

twSym = tw_symbol != "" ? tw_symbol : syminfo.ticker
f_fmt(float p) => str.tostring(p, format.mintick)
f_tail() => (tw_magic != "" ? ", MAGIC=" + tw_magic : "") + (tw_comment != "" ? ", COMMENT=" + tw_comment : "")

if takeLong and tw_enabled
    msg = (tw_opp_close ? "CLOSE," + twSym + ",SIDE=SELL" + f_tail() + ";" : "") + "BUY," + twSym + ", " + tw_vol_type + "=" + str.tostring(tw_vol_val) + ", SL=" + f_fmt(slLong) + ", TP=" + f_fmt(tpLong) + ", TPSLTYPE=PRICE" + f_tail()
    alert(msg, alert.freq_once_per_bar_close)

if takeShort and tw_enabled
    msg = (tw_opp_close ? "CLOSE," + twSym + ",SIDE=BUY" + f_tail() + ";" : "") + "SELL," + twSym + ", " + tw_vol_type + "=" + str.tostring(tw_vol_val) + ", SL=" + f_fmt(slShort) + ", TP=" + f_fmt(tpShort) + ", TPSLTYPE=PRICE" + f_tail()
    alert(msg, alert.freq_once_per_bar_close)

// =============================================================================
// MARGIN VOLUME PROFILE RENDERER
// =============================================================================

var box[] mpBox = array.new<box>()
var label[] mpLbl = array.new<label>()
if barstate.islast
    if mpBox.size() > 0
        for b in mpBox
            box.delete(b)
        mpBox.clear()
    if mpLbl.size() > 0
        for l in mpLbl
            label.delete(l)
        mpLbl.clear()
    if i_v_profile and profRows > 1 and profMax > 0
        span = profRows * prof.rowSize
        binH = span / i_bins
        bv = array.new<float>(i_bins, 0.0)
        bd = array.new<float>(i_bins, 0.0)
        for x = 0 to profRows - 1
            j = math.min(int(x * i_bins / profRows), i_bins - 1)
            tv = prof.tot.get(x)
            bv.set(j, bv.get(j) + tv)
            bd.set(j, bd.get(j) + prof.buy.get(x) - prof.sell.get(x))
        bMax = bv.max()
        x0 = bar_index + i_profOff
        for j = 0 to i_bins - 1
            v = bv.get(j)
            if v > 0
                y0 = prof.base + j * binH
                y1 = y0 + binH
                w = math.max(int(v / bMax * i_profW), 1)
                dpc = bd.get(j) / v
                tr = int(88 - v / bMax * 55)
                cc = dpc > 0.05 ? color.new(i_colBull, tr) : dpc < -0.05 ? color.new(i_colBear, tr) : color.new(color.gray, math.min(tr + 8, 92))
                mpBox.push(box.new(x0, y1, x0 + w, y0, border_color = color.new(cc, 100), bgcolor = cc))
                if i_profText and v >= bMax * 0.6
                    mpLbl.push(label.new(x0 + w, (y0 + y1) / 2, f_volFmt(v),
                         style = label.style_label_left, textcolor = color.silver,
                         color = color.new(color.black, 100), size = size.tiny))

// =============================================================================
// DASHBOARD
// =============================================================================

dbPos = switch i_dbLoc
    "Top Right" => position.top_right
    "Middle Right" => position.middle_right
    "Bottom Right" => position.bottom_right
    "Top Left" => position.top_left
    "Middle Left" => position.middle_left
    => position.bottom_left

dbTxt = switch i_dbSize
    "Tiny" => size.tiny
    "Normal" => size.normal
    "Large" => size.large
    => size.small

var table dash = table.new(position = dbPos, columns = 2, rows = 8,
 bgcolor = color.new(#10131a, 10), border_width = 1, border_color = color.gray)
if barstate.islast and i_dbShow
    ts = dbTxt
    table.cell(dash, 0, 0, "Engine Status", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 0, accountBlown ? "BLOWN" : canTrade ? "ACTIVE" : "BLOCKED",
     text_color = accountBlown ? color.red : canTrade ? color.green : color.orange, text_size = ts)
    table.cell(dash, 0, 1, "POC Target", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 1, f_fmt(dPoc), text_color = i_colPoc, text_size = ts)
    table.cell(dash, 0, 2, "CVD Bias", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 2, cvd >= 0 ? "BULLISH" : "BEARISH",
     text_color = cvd >= 0 ? i_colBull : i_colBear, text_size = ts)
    table.cell(dash, 0, 3, "Last Signal", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 3, longSignal ? "BUY" : shortSignal ? "SELL" : "NEUTRAL",
     text_color = longSignal ? i_colBull : shortSignal ? i_colBear : color.gray, text_size = ts)
    table.cell(dash, 0, 4, "Trades Today", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 4, str.tostring(tradesToday) + " / " + str.tostring(i_maxPerDay), text_size = ts)
    table.cell(dash, 0, 5, "Day P&L", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 5, str.tostring(dayPnl, "#.##"),
     text_color = dayPnl >= 0 ? i_colBull : i_colBear, text_size = ts)
    table.cell(dash, 0, 6, "Open R:R", text_color = color.white, text_size = ts)
    riskNow = not na(openEntryPx) and not na(armedStop) ?
     math.abs(openEntryPx - armedStop) : na
    rewardNow = not na(openEntryPx) and not na(armedTarget) ?
     math.abs(armedTarget - openEntryPx) : na
    table.cell(dash, 1, 6, not na(riskNow) and riskNow > 0 ?
     "1 : " + str.tostring(rewardNow / riskNow, "#.##") : "—", text_size = ts)
    table.cell(dash, 0, 7, nakedBars > 0 ? "NO BRACKET" : "Bracket", text_size = ts,
     text_color = nakedBars > 0 ? color.red : color.gray)
    table.cell(dash, 1, 7, nakedBars > 0 ? str.tostring(nakedBars) + " bars" : "OK",
     text_size = ts, text_color = nakedBars > 0 ? color.red : color.green)
