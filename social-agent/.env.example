# --- Generacion de contenido ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- LinkedIn ---
# Perfil personal: scope w_member_social, URN urn:li:person:XXXX
# Pagina de empresa: scope w_organization_social (requiere que LinkedIn
# apruebe el producto Community Management API), URN urn:li:organization:XXXX
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:00000000

# --- Instagram ---
# La cuenta debe ser Business o Creator y estar vinculada a una Pagina de
# Facebook. Una cuenta personal no puede publicar por API.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Si es true, `social publish` muestra lo que haria sin llamar a ninguna API.
DRY_RUN=false
